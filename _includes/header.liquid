{% assign current_lang = page.lang | default: site.lang %}
{% assign labels = site.data.i18n[current_lang] | default: site.data.i18n.en %}
{% assign home_url = '/' %}
{% assign publications_url = '/publications/' %}
{% assign cv_page_url = '/cv/' %}
{% if current_lang == 'zh-CN' %}
  {% assign home_url = '/zh/' %}
  {% assign publications_url = '/zh/publications/' %}
  {% assign cv_page_url = '/zh/cv/' %}
{% endif %}
<header>
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      <a class="navbar-brand title font-weight-lighter" href="{{ home_url | relative_url }}">{% if current_lang == 'zh-CN' %}杨佶昌{% else %}<span class="font-weight-bold">{{ site.first_name }}</span> {{ site.last_name }}{% endif %}</a>
      <button class="navbar-toggler collapsed navbar-toggler-main" type="button" data-nav-toggle="navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="{{ labels.nav_toggle }}">
        <span class="sr-only">{{ labels.nav_toggle }}</span>
        <span class="icon-bar top-bar"></span><span class="icon-bar middle-bar"></span><span class="icon-bar bottom-bar"></span>
      </button>
      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          <li class="nav-item section-dropdown {% if page.url == home_url %}active{% endif %}">
            <a class="nav-link" href="{{ home_url | relative_url }}" {% if page.url == home_url %}aria-current="page"{% endif %}>{{ labels.about }}</a>
            {% include navbar-sections.liquid section="about" %}
          </li>
          <li class="nav-item section-dropdown {% if page.url == publications_url %}active{% endif %}">
            <a class="nav-link" href="{{ publications_url | relative_url }}" {% if page.url == publications_url %}aria-current="page"{% endif %}>{{ labels.publications }}</a>
            {% include navbar-sections.liquid section="publications" %}
          </li>
          <li class="nav-item {% if page.url == cv_page_url %}active{% endif %}">
            <a class="nav-link" href="{{ cv_page_url | relative_url }}" {% if page.url == cv_page_url %}aria-current="page"{% endif %}>{{ labels.cv }}</a>
          </li>
          <li class="nav-item language-switch">
            {% if current_lang == 'zh-CN' %}
              <a class="nav-link" data-language-switch href="{{ page.translation_url | default: '/' | relative_url }}" lang="en" hreflang="en">English</a>
            {% else %}
              <a class="nav-link" data-language-switch href="{{ page.translation_url | default: '/zh/' | relative_url }}" lang="zh-CN" hreflang="zh-CN">中文</a>
            {% endif %}
          </li>
          {% if site.enable_darkmode %}
          <li class="toggle-container">
            <button id="light-toggle" type="button" title="{{ labels.theme }}" aria-label="{{ labels.theme }}">
              <i class="fa-solid fa-moon" id="light-toggle-dark"></i><i class="fa-solid fa-sun" id="light-toggle-light"></i>
            </button>
          </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
</header>
<script src="{{ '/assets/js/section-menu.js' | relative_url }}" defer></script>
<script src="{{ '/assets/js/language-switch.js' | relative_url }}" defer></script>
