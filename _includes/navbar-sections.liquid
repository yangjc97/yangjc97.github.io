<button class="section-menu-toggle" type="button" aria-expanded="false" aria-controls="{{ include.section }}-sections" aria-label="{{ labels.section_toggle }}"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>
<div class="section-menu" id="{{ include.section }}-sections" hidden>
{% if include.section == 'about' %}
  <a href="{{ home_url | relative_url }}#overview">{{ labels.overview }}</a>
  <a href="{{ home_url | relative_url }}#news">{{ labels.news }}</a>
  <a href="{{ home_url | relative_url }}#selected-publications">{{ labels.selected }}</a>
  <a href="{{ home_url | relative_url }}#education">{{ labels.education }}</a>
  <a href="{{ home_url | relative_url }}#talks">{{ labels.talks }}</a>
  <a href="{{ home_url | relative_url }}#teaching">{{ labels.teaching }}</a>
{% else %}
  {% assign nav_papers = site.publications | where_exp: 'paper', 'paper.published != false' | sort: 'date' | reverse %}
  {% assign nav_years = nav_papers | group_by_exp: 'paper', "paper.date | date: '%Y'" %}
  {% for year in nav_years %}<a href="{{ publications_url | relative_url }}#year-{{ year.name }}">{{ year.name }}</a>{% endfor %}
{% endif %}
</div>
