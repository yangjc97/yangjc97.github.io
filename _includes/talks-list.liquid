{% assign talks = site.talks | sort: 'date' | reverse %}
<ol class="event-list talks-list">
{% for talk in talks %}
<li><p class="event-date">{% if page.lang == 'zh-CN' %}{{ talk.date | date: '%Y 年 %-m 月 %-d 日' }}{% else %}{{ talk.date | date: '%b %d, %Y' }}{% endif %} · {% if page.lang == 'zh-CN' %}{{ talk.type_zh | default: talk.type }}{% else %}{{ talk.type }}{% endif %}</p>
<h3>{{ talk.title | escape }}</h3>
<p class="talk-venue">{% if page.lang == 'zh-CN' %}{{ talk.venue_zh | default: talk.venue }}{% else %}{{ talk.venue }}{% endif %} · <span class="event-location">{% if page.lang == 'zh-CN' %}{{ talk.location_zh | default: talk.location }}{% else %}{{ talk.location }}{% endif %}</span></p>
{{ talk.content | markdownify }}
</li>
{% endfor %}
</ol>
